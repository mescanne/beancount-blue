{
  "name": "beancount-blue-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:cashflow",
    "build:all": "TARGET=banksync vite build && TARGET=cashflow vite build",
    "build:banksync": "TARGET=banksync vite build",
    "build:cashflow": "TARGET=cashflow vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
