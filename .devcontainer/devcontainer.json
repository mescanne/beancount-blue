{
  "name": "Python 3.14 with uv",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff" 
      ]
    }
  },
  // Use the non-root user created in the Dockerfile
  "remoteUser": "vscode",
  
  // Post-create command: Install dependencies if a lockfile exists
  // Uses 'uv sync' which is extremely fast
  "postCreateCommand": "uv sync || echo 'No uv.lock found, skipping install'"
}
