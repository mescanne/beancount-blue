{
  "name": "Python 3.14 with uv",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  
  "features": {
    // Adds common CLI tools (zsh, git, curl, etc.) automatically
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },

  "remoteUser": "vscode",

  // This is the "Magic" standard for tools that don't have an official Feature yet.
  // We install uv and immediately sync dependencies.
  "postCreateCommand": "pip install uv && uv sync || echo 'No uv.lock found'"
}
